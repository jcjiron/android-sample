# Copia este archivo como `keystore.properties` (en esta misma carpeta) y llena los valores.
# keystore.properties y los .jks están en .gitignore: NUNCA se suben al repo.
#
# Cada valor también se puede pasar como variable de entorno con el mismo nombre
# (así se hace en CI, con secrets). La variable de entorno gana sobre este archivo.

# --- Release / Play Store (upload key) — obligatorio para publicar ---
RELEASE_STORE_FILE=release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=upload
RELEASE_KEY_PASSWORD=

# --- Debug compartido — opcional ---
# Solo si quieren que todo el equipo tenga la misma SHA-1 de debug (Firebase, Google Maps…).
# Si se deja vacío, Android Studio usa su debug keystore automático (~/.android/debug.keystore).
DEBUG_STORE_FILE=debug.jks
DEBUG_STORE_PASSWORD=
DEBUG_KEY_ALIAS=
DEBUG_KEY_PASSWORD=
